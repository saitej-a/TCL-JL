# Template for production environment — copy to `.env.prod` and fill in real values.
# `.env.prod` is gitignored; never commit real credentials.
POSTGRES_USER=tcs_tracker
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=tcs_joining_tracker
# Optional overrides (defaults shown in docker-compose.prod.yml):
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Vercel (serverless) deployment ---
# Vercel's Neon integration injects DATABASE_URL (parsed by base.py) and its
# Upstash integration injects REDIS_URL + KV_URL; do not set those by hand.
# NOTE: Upstash rejects SELECT > 0, so the compose db1/db2 split cannot be
# reproduced there — never point CELERY_BROKER_URL/CELERY_RESULT_BACKEND at an
# Upstash URL with a /1 or /2 suffix. Serverless runs with CELERY_TASK_ALWAYS_EAGER=1,
# which keeps task results in-process and never touches the broker.
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_SECRET_KEY=generate-with-openssl-rand-hex-32
# JWT_SECRET_KEY=generate-a-second-distinct-256-bit-value
# DJANGO_ALLOWED_HOSTS=localhost,.vercel.app
# CSRF_TRUSTED_ORIGINS=https://*.vercel.app
# FRONTEND_URL=https://your-app.vercel.app
# CELERY_TASK_ALWAYS_EAGER=1
