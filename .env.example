# TCS Joining Tracker — development environment template
# Copy to .env (gitignored) and adjust for local dev.
# Production compose receives real values via deployment environment, NOT files (D-11).

COMPOSE_PROJECT_NAME=tcs_jl
POSTGRES_USER=tcs_admin
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=tcs_joining_tracker
TZ=Asia/Kolkata

# Redis db partitioning per T1.5: 0=cache/throttle, 1=broker, 2=results
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Dedicated JWT signing secret (06 §3.1.1: distinct from DJANGO_SECRET_KEY).
# Optional in dev (falls back to SECRET_KEY); REQUIRED in production as a distinct 256-bit value.
# JWT_SECRET_KEY=
